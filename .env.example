PUBLIC_ORIGIN=https://suivi.hugoloiseau.fr
VIEWER_USERNAME=ami
VIEWER_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_RANDOM_PASSWORD
QBIT_URL=http://192.168.1.10:8080
